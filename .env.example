# ═══════════════════════════════════════════════════════════════
# alice 配置 —— 复制为 .env 后按需修改
#
#   cp .env.example <实例目录>/.env
#   vim <实例目录>/.env
#
# 所有变量都是【必填】。任何一个缺失或留空，docker compose 会立即报错，
# 且不会创建任何目录。
# ═══════════════════════════════════════════════════════════════

# ── 容器身份 ─────────────────────────────────────────────────
# 容器名（同时用作 hostname）
CONTAINER_NAME=alice

# 容器内用户名 / uid / gid
# ⚠️ USER_UID / USER_GID 必须与宿主侧 HOME_DIR 的属主一致
#    （例如宿主是 you:users = 1000:100，就写 USER_UID=1000 / USER_GID=100）。
#    不一致时 entrypoint 会把宿主侧家目录顶层属主改成下面的值，
#    而已有子目录不改 —— 结果可能是 sshd 拒绝认证。
#    查询宿主属主：stat -c "%u:%g" <HOME_DIR>（目录还没建就看它的父目录）
USER_NAME=grimm
USER_UID=1000
USER_GID=1000

# ── 网络 ─────────────────────────────────────────────────────
# 宿主侧 sshd 端口（映射到容器内 22）
# 访问方式：ssh -p 22222 grimm@127.0.0.1
SSH_PORT=22222

# ── 路径（都用绝对路径）──────────────────────────────────────
# 宿主侧家目录：整个挂载为容器内 /home/<USER_NAME>（名字、位置任意）
# 故意留空：留空即「缺失」，compose 立即报错，避免忘改时静默创建 /home/you/...
# 注意最好提前建好并设为与 USER_UID:USER_GID 一致的属主（Docker 自动建会是 root）
HOME_DIR=

# 项目目录：本项目所在位置（含 image/，用于本地构建镜像）
# 同样故意留空：留空即「缺失」→ compose 立即报错
PROJECT_DIR=

# ── 镜像 ─────────────────────────────────────────────────────
IMAGE_NAME=alice:local
